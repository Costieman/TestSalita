tesy","icon":"👋","description":"Natural greetings, polite responses, thanks, and leave-taking before grammar-heavy work.","unlockAt":0},{"id":"introductions","title":"Names & Introductions","icon":"🙂","description":"Say who you are, ask someone’s name, and introduce another person.","unlockAt":10},{"id":"origin","title":"Origin & Home","icon":"🌏","description":"Ask where someone is from, where they live, and explain that you are learning Bisaya.","unlockAt":28},{"id":"wellbeing","title":"How You Feel","icon":"💛","description":"Talk about being well, tired, hungry, thirsty, happy, or unwell.","unlockAt":50},{"id":"questions","title":"Questions & Help","icon":"❓","description":"Find places, ask meanings, request repetition, and manage conversations when you do not understand.","unlockAt":76},{"id":"food","title":"Food & Everyday Wants","icon":"🍲","description":"Express wants and needs, order simply, ask prices, and handle everyday transactions.","unlockAt":108},{"id":"grammar","title":"People, Place & Particles","icon":"🧩","description":"Build the sentence system using pronouns, markers, location words, linkers, and high-frequency particles.","unlockAt":148},{"id":"verbs","title":"Verb Engine","icon":"⚙️","description":"Learn high-value roots and Cebuano aspect and voice patterns through useful sentences.","unlockAt":205},{"id":"spanish","title":"Spanish Connections","icon":"🟠","description":"Recognise Spanish-origin vocabulary that is fully integrated into everyday Cebuano.","unlockAt":265},{"id":"codeSwitching","title":"Natural Bisaya-English","icon":"🔀","description":"Understand natural Cebuano-English code-switching while retaining Cebuano particles and sentence patterns.","unlockAt":305}],"items":[{"id":"ceb_g_kumusta","module":"greetings","kind":"phrase","skill":"conversation","term":"Kumusta!","meaning":"Hello! / How is it going?","origin":"Spanish","example":"Kumusta!","natural":"Hello! / How is it going?","hint":"A common greeting derived from Spanish. Kumusta ka? directly asks how one person is.","analysis":{"tokens":[["Kumusta","hello / how-are-things"]],"literal":"How are things?"},"accepted":["Kamusta!","Musta!"]},{"id":"ceb_g_maayong_buntag","module":"greetings","kind":"phrase","skill":"conversation","term":"Maayong buntag","meaning":"Good morning","origin":"Native","example":"Maayong buntag!","natural":"Good morning!","hint":"Maayong is maayo plus the linker -ng; buntag means morning.","analysis":{"tokens":[["Maayo-ng","good-LINK"],["buntag","morning"]],"literal":"Good morning."}},{"id":"ceb_g_kumusta_ka","module":"greetings","kind":"phrase","skill":"conversation","term":"Kumusta ka?","meaning":"How are you?","origin":"Spanish","example":"Kumusta ka?","natural":"How are you?","hint":"Ka is the short second-person singular pronoun.","analysis":{"tokens":[["Kumusta","how-are-things"],["ka","you"]],"literal":"How-are-things you?"},"accepted":["Kamusta ka?","Musta ka?"]},{"id":"ceb_g_maayo_ra_ko","module":"greetings","kind":"phrase","skill":"conversation","term":"Maayo ra ko","meaning":"I’m fine / I’m okay","origin":"Native","example":"Maayo ra ko, salamat.","natural":"I’m fine, thank you.","hint":"Ra often means only or just, but here it helps create the natural sense of being okay or fine.","analysis":{"tokens":[["Maayo","well / good"],["ra","just / only"],["ko","I"]],"literal":"Well just I."},"accepted":["Maayo man ko","Okay ra ko"]},{"id":"ceb_g_salamat","module":"greetings","kind":"phrase","skill":"conversation","term":"Salamat","meaning":"Thank you","origin":"Borrowed","originDetail":"Malay/Arabic pathway","example":"Salamat!","natural":"Thank you!","hint":"The everyday default for thanking someone.","analysis":{"tokens":[["Salamat","thanks"]],"literal":"Thanks."}},{"id":"ceb_g_daghang_salamat","module":"greetings","kind":"phrase","skill":"conversation","term":"Daghang salamat","meaning":"Thank you very much / Many thanks","origin":"Mixed","example":"Daghang salamat!","natural":"Thank you very much!","hint":"Daghang is daghan plus the linker -g and means many or much.","analysis":{"tokens":[["Daghan-g","many-LINK"],["salamat","thanks"]],"literal":"Many thanks."},"accepted":["Salamat kaayo"]},{"id":"ceb_g_oo","module":"greetings","kind":"word","skill":"conversation","term":"Oo","meaning":"Yes","origin":"Native","example":"Oo.","natural":"Yes.","hint":"A neutral affirmative response.","analysis":{"tokens":[["Oo","yes"]],"literal":"Yes."}},{"id":"ceb_g_dili","module":"greetings","kind":"word","skill":"conversation","term":"Dili","meaning":"No / Not","origin":"Native","example":"Dili.","natural":"No.","hint":"Dili is used for no and for many forms of negation.","analysis":{"tokens":[["Dili","no / not"]],"literal":"No / not."}},{"id":"ceb_g_walay_sapayan","module":"greetings","kind":"phrase","skill":"conversation","term":"Walay sapayan","meaning":"You’re welcome / No problem","origin":"Native","example":"Walay sapayan.","natural":"You’re welcome.","hint":"Often shortened in speech to Way sapayan.","analysis":{"tokens":[["Wala-y","none-LINK"],["sapayan","matter / concern"]],"literal":"Nothing to be concerned about."},"accepted":["Way sapayan"]},{"id":"ceb_g_sige","module":"greetings","kind":"word","skill":"conversation","term":"Sige","meaning":"Okay / All right / Go ahead","origin":"Spanish","example":"Sige.","natural":"Okay.","hint":"A very common conversational word whose exact meaning depends on context.","analysis":{"tokens":[["Sige","okay / go-ahead"]],"literal":"Okay."}},{"id":"ceb_g_amping","module":"greetings","kind":"phrase","skill":"conversation","term":"Amping!","meaning":"Take care!","origin":"Native","example":"Sige, amping!","natural":"Okay, take care!","hint":"A high-frequency leave-taking expression.","analysis":{"tokens":[["Sige","okay"],["amping","take-care / be-careful"]],"literal":"Okay, take care."}},{"id":"ceb_g_ikaw_pud","module":"greetings","kind":"phrase","skill":"conversation","term":"Ikaw pud","meaning":"You too","origin":"Native","example":"Ikaw pud.","natural":"You too.","hint":"Pud means also or too. Sad is a common regional alternative.","analysis":{"tokens":[["Ikaw","you"],["pud","also / too"]],"literal":"You also."},"accepted":["Ikaw sad"]},{"id":"ceb_g_palihug","module":"greetings","kind":"word","skill":"conversation","term":"Palihug","meaning":"Please","origin":"Native","example":"Palihug.","natural":"Please.","hint":"Palihog is an accepted spelling variant.","analysis":{"tokens":[["Palihug","please"]],"literal":"Please."},"accepted":["Palihog"]},{"id":"ceb_g_pasayloa_ko","module":"greetings","kind":"phrase","skill":"conversation","term":"Pasayloa ko","meaning":"I’m sorry / Forgive me","origin":"Native","example":"Pasayloa ko.","natural":"I’m sorry.","hint":"Literally asks the listener to forgive the speaker.","analysis":{"tokens":[["Pasaylo-a","forgive-IMP"],["ko","me"]],"literal":"Forgive me."},"accepted":["Pasaylo-a ko"]},{"id":"ceb_g_maayong_hapon","module":"greetings","kind":"phrase","skill":"conversation","term":"Maayong hapon","meaning":"Good afternoon","origin":"Native","example":"Maayong hapon!","natural":"Good afternoon!","hint":"The same maayo plus linker pattern used in maayong buntag.","analysis":{"tokens":[["Maayo-ng","good-LINK"],["hapon","afternoon"]],"literal":"Good afternoon."}},{"id":"ceb_g_maayong_gabii","module":"greetings","kind":"phrase","skill":"conversation","term":"Maayong gabii","meaning":"Good evening","origin":"Native","example":"Maayong gabii!","natural":"Good evening!","hint":"Gabii means evening or night; gabi-i is another written form.","analysis":{"tokens":[["Maayo-ng","good-LINK"],["gabii","evening / night"]],"literal":"Good evening."},"accepted":["Maayong gabi-i"]},{"id":"ceb_g_maayong_adlaw","module":"greetings","kind":"phrase","skill":"conversation","term":"Maayong adlaw","meaning":"Good day","origin":"Native","example":"Maayong adlaw!","natural":"Good day!","hint":"A useful general daytime greeting.","analysis":{"tokens":[["Maayo-ng","good-LINK"],["adlaw","day"]],"li