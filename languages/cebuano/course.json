ord means ‘Please’ ?","answer":"Palihug","choices":["Palihug","Salamat","Amping","Dili"],"itemIds":["ceb_g_palihug"]},{"id":"ceb_g_ex_10","module":"greetings","type":"sentence-builder","prompt":"Build: ‘I’m sorry.’","answerTokens":["Pasayloa","ko."],"wordBank":["ko.","Pasayloa","ka","Maayo","Sige","Oo"],"itemIds":["ceb_g_pasayloa_ko"]},{"id":"ceb_g_ex_11","module":"greetings","type":"choice","prompt":"Which greeting is used in the evening?","answer":"Maayong gabii","choices":["Maayong gabii","Maayong buntag","Maayong hapon","Maayo ra ko"],"itemIds":["ceb_g_maayong_gabii"]},{"id":"ceb_g_ex_12","module":"greetings","type":"choice","prompt":"What is a natural reply to ‘Amping!’?","answer":"Ikaw pud","choices":["Ikaw pud","Dili","Maayong buntag","Pasayloa ko"],"itemIds":["ceb_g_amping","ceb_g_ikaw_pud"]}]}