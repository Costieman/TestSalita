{"schemaVersion":1,"moduleId":"spanish","status":"foundation","reviewStatus":"native-review-required","items":[{"id":"ceb_s_lunes","module":"spanish","kind":"word","skill":"calendar","term":"Lunes","meaning":"Monday","origin":"Spanish","originDetail":"Spanish lunes","example":"Karong Lunes libre ko.","natural":"I’m free this Monday.","hint":"Cebuano day names are established Spanish-derived vocabulary.","analysis":{"tokens":[["Karong","this / current"],["Lunes","Monday"],["libre","free"],["ko","I"]],"literal":"This Monday free I."}},{"id":"ceb_s_martes","module":"spanish","kind":"word","skill":"calendar","term":"Martes","meaning":"Tuesday","origin":"Spanish","originDetail":"Spanish martes","example":"Martes ugma.","natural":"Tomorrow is Tuesday.","hint":"Use the day name naturally with Cebuano time words such as ugma.","analysis":{"tokens":[["Martes","Tuesday"],["ugma","tomorrow"]],"literal":"Tuesday tomorrow."}},{"id":"ceb_s_miyerkules","module":"spanish","kind":"word","skill":"calendar","term":"Miyerkules","meaning":"Wednesday","origin":"Spanish","originDetail":"Spanish miércoles","example":"Magklase ko sa Miyerkules.","natural":"I have class on Wednesday.","hint":"The spelling reflects Cebuano pronunciation rather than modern Spanish spelling.","analysis":{"tokens":[["Magklase","will-have-class"],["ko","I"],["sa","on"],["Miyerkules","Wednesday"]],"literal":"Have-class I on Wednesday."},"accepted":["Miyerkoles"]},{"id":"ceb_s_huwebes","module":"spanish","kind":"word","skill":"calendar","term":"Huwebes","meaning":"Thursday","origin":"Spanish","originDetail":"Spanish jueves","example":"Niaging Huwebes nagkita mi.","natural":"We met last Thursday.","hint":"Niaging marks the preceding or last occurrence.","analysis":{"tokens":[["Niaging","last / previous"],["Huwebes","Thursday"],["nagkita","met"],["mi","we-exclusive"]],"literal":"Last Thursday met we."}},{"id":"ceb_s_biyernes","module":"spanish","kind":"word","skill":"calendar","term":"Biyernes","meaning":"Friday","origin":"Spanish","originDetail":"Spanish viernes","example":"Wala koy klase karong Biyernes.","natural":"I have no class this Friday.","hint":"The Cebuano spelling makes the initial sound explicit.","analysis":{"tokens":[["Wala","none"],["ko-y","I-LINK"],["klase","class"],["karong","this"],["Biyernes","Friday"]],"literal":"None I class this Friday."}},{"id":"ceb_s_sabado","module":"spanish","kind":"word","skill":"calendar","term":"Sabado","meaning":"Saturday","origin":"Spanish","originDetail":"Spanish sábado","example":"Moadto ta sa merkado sa Sabado.","natural":"We’ll go to the market on Saturday.","hint":"Day names combine normally with Cebuano markers and verbs.","analysis":{"tokens":[["Moadto","will-go"],["ta","we-inclusive"],["sa","to"],["merkado","market"],["sa","on"],["Sabado","Saturday"]],"literal":"Will-go we to market on Saturday."}},{"id":"ceb_s_domingo","module":"spanish","kind":"word","skill":"calendar","term":"Domingo","meaning":"Sunday","origin":"Spanish","originDetail":"Spanish domingo","example":"Matag Domingo moadto ko sa simbahan.","natural":"Every Sunday I go to church.","hint":"Dominggo is a common alternative spelling.","analysis":{"tokens":[["Matag","every"],["Domingo","Sunday"],["moadto","go"],["ko","I"],["sa","to"],["simbahan","church"]],"literal":"Every Sunday go I to church."},"accepted":["Dominggo"]},{"id":"ceb_s_enero","module":"spanish","kind":"word","skill":"calendar","term":"Enero","meaning":"January","origin":"Spanish","originDetail":"Spanish enero","example":"Sa Enero magsugod ang klase.","natural":"Classes start in January.","hint":"Month names are commonly Spanish-derived.","analysis":{"tokens":[["Sa","in"],["Enero","January"],["magsugod","will-start"],["ang","topic marker"],["klase","class"]],"literal":"In January will-start [TOPIC] class."}},{"id":"ceb_s_hulyo","module":"spanish","kind":"word","skill":"calendar","term":"Hulyo","meaning":"July","origin":"Spanish","originDetail":"Spanish julio","example":"Sa Hulyo ang akong adlawng natawhan.","natural":"My birthday is in July.","hint":"Hulyo reflects Cebuano spelling and pronunciation.","analysis":{"tokens":[["Sa","in"],["Hulyo","July"],["ang","topic marker"],["akong","my"],["adlaw-ng","day-LINK"],["natawhan","birth"]],"literal":"In July [TOPIC] my birth-day."}},{"id":"ceb_s_disyembre","module":"spanish","kind":"word","skill":"calendar","term":"Disyembre","meaning":"December","origin":"Spanish","originDetail":"Spanish diciembre","example":"Mopauli mi sa Disyembre.","natural":"We’ll go home in December.","hint":"The spelling follows Cebuano sound patterns.","analysis":{"tokens":[["Mopauli","will-go-home"],["mi","we-exclusive"],["sa","in"],["Disyembre","December"]],"literal":"Will-go-home we in December."}},{"id":"ceb_s_oras","module":"spanish","kind":"word","skill":"time","term":"Oras","meaning":"Hour / time","origin":"Spanish","originDetail":"Spanish hora","example":"Unsang orasa na?","natural":"What time is it?","hint":"Orasa is oras plus the ending used in this question.","analysis":{"tokens":[["Unsa-ng","what-LINK"],["oras-a","time"],["na","now"]],"literal":"What time now?"},"accepted":["Unsa nang orasa?"]},{"id":"ceb_s_ala_una","module":"spanish","kind":"phrase","skill":"time","term":"Ala una","meaning":"One o’clock","origin":"Spanish","originDetail":"Spanish a la una","example":"Ala una sa hapon.","natural":"One o’clock in the afternoon.","hint":"Use ala una for one o’clock; plural alas is used with other numbers.","analysis":{"tokens":[["Ala","at-the"],["una","one"],["sa","in-the"],["hapon","afternoon"]],"literal":"At-the one in afternoon."}},{"id":"ceb_s_alas_dos","module":"spanish","kind":"phrase","skill":"time","term":"Alas dos","meaning":"Two o’clock","origin":"Spanish","originDetail":"Spanish a las dos","example":"Alas dos sa hapon.","natural":"Two o’clock in the afternoon.","hint":"Clock time often retains Spanish-style number forms.","analysis":{"tokens":[["Alas","at-the-plural"],["dos","two"],["sa","in-the"],["hapon","afternoon"]],"literal":"At-the two in afternoon."}},{"id":"ceb_s_minuto","module":"spanish","kind":"word","skill":"time","term":"Minuto","meaning":"Minute","origin":"Spanish","originDetail":"Spanish minuto","example":"Lima ka minuto lang.","natural":"Just five minutes.","hint":"The Cebuano number lima combines with the borrowed time unit minuto.","analysis":{"tokens":[["Lima","five"],["ka","count linker"],["minuto","minutes"],["lang","only"]],"literal":"Five [COUNT] minutes only."}},{"id":"ceb_s_semana","module":"spanish","kind":"word","skill":"time","term":"Semana","meaning":"Week","origin":"Spanish","originDetail":"Spanish semana","example":"Sunod semana mobalik ko.","natural":"I’ll return next week.","hint":"Semana is fully integrated and combines with native modifiers such as sunod.","analysis":{"tokens":[["Sunod","next"],["semana","week"],["mobalik","will-return"],["ko","I"]],"literal":"Next week will-return I."}},{"id":"ceb_s_merkado","module":"spanish","kind":"word","skill":"daily-life","term":"Merkado","meaning":"Market","origin":"Spanish","originDetail":"Spanish mercado","example":"Moadto ko sa merkado.","natural":"I’m going to the market.","hint":"A common everyday Spanish-derived noun.","analysis":{"tokens":[["Moadto","will-go"],["ko","I"],["sa","to-the"],["merkado","market"]],"literal":"Will-go I to market."}},{"id":"ceb_s_meryenda","module":"spanish","kind":"word","skill":"daily-life","term":"Meryenda","meaning":"Snack / light meal","origin":"Spanish","originDetail":"Spanish merienda","example":"Magmeryenda ta.","natural":"Let’s have a snack.","hint":"The borrowed noun is also used inside Cebuano verb forms such as magmeryenda.","analysis":{"tokens":[["Mag-meryenda","have-a-snack"],["ta","we-inclusive"]],"literal":"Have-snack we."},"accepted":["Meryinda"]},{"id":"ceb_s_kutsara","module":"spanish","kind":"word","skill":"daily-life","term":"Kutsara","meaning":"Spoon","origin":"Spanish","originDetail":"Spanish cuchara","example":"Naa bay kutsara?","natural":"Is there a spoon?","hint":"The spelling reflects Cebuano pronunciation of the borrowed word.","analysis":{"tokens":[["Naa","there-is"],["ba-y","question-LINK"],["kutsara","spoon"]],"literal":"There-is question spoon?"}},{"id":"ceb_s_tinidor","module":"spanish","kind":"word","skill":"daily-life","term":"Tinidor","meaning":"Fork","origin":"Spanish","originDetail":"Spanish tenedor","example":"Kutsara ug tinidor, palihug.","natural":"A spoon and fork, please.","hint":"The vowels have adapted to Cebuano pronunciation.","analysis":{"tokens":[["Kutsara","spoon"],["ug","and"],["tinidor","fork"],["palihug","please"]],"literal":"Spoon and fork, please."}},{"id":"ceb_s_plato","module":"spanish","kind":"word","skill":"daily-life","term":"Plato","meaning":"Plate","origin":"Spanish","originDetail":"Spanish plato","example":"Ibutang ang pagkaon sa plato.","natural":"Put the food on the plate.","hint":"Plato is a fully integrated everyday noun.","analysis":{"tokens":[["Ibutang","put"],["ang","topic marker"],["pagkaon","food"],["sa","on-the"],["plato","plate"]],"literal":"Put [TOPIC] food on plate."}}],"dialogue":{"title":"Making plans in Spanish Square","level":"Beginner 5","note":"The calendar, clock-time, and everyday nouns in this dialogue are Spanish-derived, but they follow Cebuano sentence structure and combine with native verbs, markers, and particles.","lines":[{"speaker":"A","text":"Unsang adlawa ta moadto sa merkado?","tokens":[["Unsa-ng","what-LINK"],["adlaw-a","day"],["ta","we-inclusive"],["moadto","will-go"],["sa","to"],["merkado","market"]],"literal":"What day we will-go to market?","natural":"What day will we go to the market?"},{"speaker":"B","text":"Sa Sabado.","tokens":[["Sa","on"],["Sabado","Saturday"]],"literal":"On Saturday.","natural":"On Saturday."},{"speaker":"A","text":"Unsang orasa ta magkita?","tokens":[["Unsa-ng","what-LINK"],["oras-a","time"],["ta","we-inclusive"],["magkita","meet"]],"literal":"What time we meet?","natural":"What time will we meet?"},{"speaker":"B","text":"Alas dos sa hapon. Magmeryenda ta didto.","tokens":[["Alas","at-the"],["dos","two"],["sa","in"],["hapon","afternoon"],["Mag-meryenda","have-snack"],["ta","we-inclusive"],["didto","there"]],"literal":"At-the two in afternoon. Have-snack we there.","natural":"At two in the afternoon. We’ll have a snack there."},{"speaker":"A","text":"Sige. Mopalit ta og plato, kutsara, ug tinidor.","tokens":[["Sige","okay"],["Mopalit","will-buy"],["ta","we-inclusive"],["og","object marker"],["plato","plate"],["kutsara","spoon"],["ug","and"],["tinidor","fork"]],"literal":"Okay. Will-buy we [OBJ] plate, spoon, and fork.","natural":"Okay. We’ll buy plates, spoons, and forks."}]},"starterExercises":[{"id":"ceb_s_ex_01","type":"choice","prompt":"Which word means ‘Monday’?","answer":"Lunes","choices":["Lunes","Martes","Sabado","Domingo"],"itemIds":["ceb_s_lunes"]},{"id":"ceb_s_ex_02","type":"sentence-builder","prompt":"Build: ‘Tomorrow is Tuesday.’","answerTokens":["Martes","ugma."],"wordBank":["ugma.","Martes","Lunes","karon","ko","sa"],"itemIds":["ceb_s_martes"]},{"id":"ceb_s_ex_03","type":"sentence-builder","prompt":"Build: ‘I have class on Wednesday.’","answerTokens":["Magklase","ko","sa","Miyerkules."],"wordBank":["Miyerkules.","ko","Magklase","sa","Martes","ugma"],"itemIds":["ceb_s_miyerkules"]},{"id":"ceb_s_ex_04","type":"choice","prompt":"Which word means ‘December’?","answer":"Disyembre","choices":["Disyembre","Enero","Hulyo","Semana"],"itemIds":["ceb_s_disyembre"]},{"id":"ceb_s_ex_05","type":"sentence-builder","prompt":"Build: ‘What time is it?’","answerTokens":["Unsang","orasa","na?"],"wordBank":["na?","orasa","Unsang","Lunes","ko","sa"],"itemIds":["ceb_s_oras"]},{"id":"ceb_s_ex_06","type":"sentence-builder","prompt":"Build: ‘Two o’clock in the afternoon.’","answerTokens":["Alas","dos","sa","hapon."],"wordBank":["hapon.","dos","Alas","sa","una","buntag"],"itemIds":["ceb_s_alas_dos"]},{"id":"ceb_s_ex_07","type":"sentence-builder","prompt":"Build: ‘Just five minutes.’","answerTokens":["Lima","ka","minuto","lang."],"wordBank":["lang.","minuto","Lima","ka","oras","dos"],"itemIds":["ceb_s_minuto"]},{"id":"ceb_s_ex_08","type":"choice","prompt":"What does ‘merkado’ mean?","answer":"Market","choices":["Market","Snack","Plate","Week"],"itemIds":["ceb_s_merkado"]},{"id":"ceb_s_ex_09","type":"sentence-builder","prompt":"Build: ‘Let’s have a snack.’","answerTokens":["Magmeryenda","ta."],"wordBank":["ta.","Magmeryenda","ko","merkado","sa","Lunes"],"itemIds":["ceb_s_meryenda"]},{"id":"ceb_s_ex_10","type":"sentence-builder","prompt":"Build: ‘A spoon and fork, please.’","answerTokens":["Kutsara","ug","tinidor,","palihug."],"wordBank":["palihug.","tinidor,","Kutsara","ug","plato","ko"],"itemIds":["ceb_s_kutsara","ceb_s_tinidor"]},{"id":"ceb_s_ex_11","type":"choice","prompt":"Which word means ‘plate’?","answer":"Plato","choices":["Plato","Kutsara","Tinidor","Meryenda"],"itemIds":["ceb_s_plato"]},{"id":"ceb_s_ex_12","type":"sentence-builder","prompt":"Build: ‘We’ll go to the market on Saturday.’","answerTokens":["Moadto","ta","sa","merkado","sa","Sabado."],"wordBank":["Sabado.","merkado","Moadto","ta","sa","sa"],"itemIds":["ceb_s_sabado","ceb_s_merkado"]}]}