  "dialogue": {
    "title": "Meeting someone in Bisaya",
    "level": "Beginner 1",
    "note": "Ako si ___ is the shortest natural self-introduction. Unsa imong ngalan? and Unsay imong ngalan? are both accepted, while pangalan is a common alternative to ngalan.",
    "lines": [
      {
        "speaker": "A",
        "text": "Maayong buntag. Ako si Alex. Unsa imong ngalan?",
        "tokens": [["Maayo-ng", "good-LINK"], ["buntag", "morning"], ["Ako", "I"], ["si", "personal-name marker"], ["Alex", "Alex"], ["Unsa", "what"], ["imong", "your"], ["ngalan", "name"]],
        "literal": "Good morning. I [name-marker] Alex. What your name?",
        "natural": "Good morning. I’m Alex. What’s your name?"
      },
      {
        "speaker": "B",
        "text": "Akong ngalan kay Mia. Palihug tawga lang ko og Mia.",
        "tokens": [["Ako-ng", "my-LINK"], ["ngalan", "name"], ["kay", "equative marker"], ["Mia", "Mia"], ["Palihug", "please"], ["tawag-a", "call-IMP"], ["lang", "just"], ["ko", "me"], ["og", "as"], ["Mia", "Mia"]],
        "literal": "My name [equative] Mia. Please call just me as Mia.",
        "natural": "My name is Mia. Please just call me Mia."
      },
      {
        "speaker": "A",
        "text": "Nalipay ko nga nakaila ko nimo.",
        "tokens": [["Nalipay", "became-happy"], ["ko", "I"], ["nga", "linker"], ["nakaila", "became-acquainted"], ["ko", "I"], ["nimo", "with-you"]],
        "literal": "Happy I that acquainted I with-you.",
        "natural": "Nice to meet you."
      },
      {
        "speaker": "B",
        "text": "Nalipay pud ko nga nakaila ko nimo.",
        "tokens": [["Nalipay", "became-happy"], ["pud", "also"], ["ko", "I"], ["nga", "linker"], ["nakaila", "became-acquainted"], ["ko", "I"], ["nimo", "with-you"]],
        "literal": "Happy also I that acquainted I with-you.",
        "natural": "Nice to meet you too."
      }
    ]
  },
