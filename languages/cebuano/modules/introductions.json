    {
      "id": "ceb_i_ako_si",
      "module": "introductions",
      "kind": "pattern",
      "skill": "conversation",
      "term": "Ako si ___",
      "meaning": "I am ___ / My name is ___",
      "origin": "Native",
      "example": "Ako si Lucille.",
      "natural": "I’m Lucille.",
      "hint": "Si marks a personal name. Cebuano does not require a separate word corresponding to English ‘am’ in this pattern.",
      "analysis": {
        "tokens": [["Ako", "I"], ["si", "personal-name marker"], ["Lucille", "Lucille"]],
        "literal": "I [name-marker] Lucille."
      }
    },
    {
      "id": "ceb_i_name_q",
      "module": "introductions",
      "kind": "phrase",
      "skill": "conversation",
      "term": "Unsa imong ngalan?",
      "meaning": "What is your name?",
      "origin": "Native",
      "example": "Unsa imong ngalan?",
      "natural": "What’s your name?",
      "hint": "Unsay is a common contracted form of unsa plus the linker. Ngalan and pangalan are both heard in everyday speech.",
      "analysis": {
        "tokens": [["Unsa", "what"], ["imong", "your"], ["ngalan", "name"]],
        "literal": "What your name?"
      },
      "accepted": ["Unsay imong ngalan?", "Unsa'y imong ngalan?", "Unsay ngalan nimo?", "Unsay imong pangalan?", "Unsa imong pangalan?"]
    },
    {
