      "module": "introductions",
      "kind": "pattern",
      "skill": "conversation",
      "term": "Akong ngalan kay ___",
      "meaning": "My name is ___",
      "origin": "Native",
      "example": "Akong ngalan kay Mia.",
      "natural": "My name is Mia.",
