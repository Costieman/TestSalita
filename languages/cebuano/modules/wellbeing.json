  "dialogue": {
    "title": "How are you feeling?",
    "level": "Beginner 2",
    "note": "Physical sensations commonly use experienced-state forms such as gikapoy, gigutom, and giuhaw. These should be learned as complete conversational patterns rather than reduced to English adjective order.",
    "lines": [
      {
        "speaker": "A",
        "text": "Kumusta ka?",
        "tokens": [["Kumusta", "how-are-things"], ["ka", "you"]],
        "literal": "How-are-things you?",
        "natural": "How are you?"
      },
      {
        "speaker": "B",
        "text": "Medyo gikapoy ko.",
        "tokens": [["Medyo", "somewhat"], ["gikapoy", "experienced-tiredness"], ["ko", "I"]],
        "literal": "Somewhat tired-experienced I.",
        "natural": "I’m a little tired."
      },
      {
        "speaker": "A",
        "text": "Gigutom ka?",
        "tokens": [["Gigutom", "experienced-hunger"], ["ka", "you"]],
        "literal": "Hungry-experienced you?",
        "natural": "Are you hungry?"
      },
      {
        "speaker": "B",
        "text": "Oo. Gigutom ko ug giuhaw pud ko.",
        "tokens": [["Oo", "yes"], ["Gigutom", "experienced-hunger"], ["ko", "I"], ["ug", "and"], ["giuhaw", "experienced-thirst"], ["pud", "also"], ["ko", "I"]],
        "literal": "Yes. Hungry-experienced I and thirsty-experienced also I.",
        "natural": "Yes. I’m hungry and thirsty too."
      },
      {
        "speaker": "A",
        "text": "Sakit ba imong ulo?",
        "tokens": [["Sakit", "painful"], ["ba", "question"], ["imong", "your"], ["ulo", "head"]],
        "literal": "Painful Q your head?",
        "natural": "Does your head hurt?"
      },
      {
        "speaker": "B",
        "text": "Dili. Okay ra ko.",
        "tokens": [["Dili", "no / not"], ["Okay", "okay"], ["ra", "just"], ["ko", "I"]],
        "literal": "No. Okay just I.",
        "natural": "No. I’m okay."
      }
    ]
  },
