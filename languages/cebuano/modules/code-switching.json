{"schemaVersion":1,"moduleId":"codeSwitching","status":"foundation","reviewStatus":"native-review-required","items":[{"id":"ceb_cs_mag_meeting","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"Mag-meeting mi karon","meaning":"We’re having / will have a meeting now","origin":"Mixed","example":"Mag-meeting mi karon.","natural":"We’re having a meeting now.","hint":"The English noun meeting takes Cebuano mag- and the Cebuano pronoun mi.","analysis":{"tokens":[["Mag-meeting","have-a-meeting"],["mi","we-exclusive"],["karon","now"]],"literal":"Have-meeting we now."}},{"id":"ceb_cs_nag_meeting","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"Nag-meeting mi ganiha","meaning":"We had a meeting earlier","origin":"Mixed","example":"Nag-meeting mi ganiha.","natural":"We had a meeting earlier.","hint":"Nag- places the English root inside a Cebuano ongoing or completed-in-context verb pattern.","analysis":{"tokens":[["Nag-meeting","held-a-meeting"],["mi","we-exclusive"],["ganiha","earlier"]],"literal":"Meeting we earlier."}},{"id":"ceb_cs_i_send","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"I-send lang nako ang file","meaning":"I’ll just send the file","origin":"Mixed","example":"I-send lang nako ang file.","natural":"I’ll just send the file.","hint":"The English root send follows Cebuano i- while lang softens the action.","analysis":{"tokens":[["I-send","send-it"],["lang","just"],["nako","by-me"],["ang","topic marker"],["file","file"]],"literal":"Send just by-me [TOPIC] file."}},{"id":"ceb_cs_gi_download","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"Gi-download nako ang report","meaning":"I downloaded the report","origin":"Mixed","example":"Gi-download nako ang report.","natural":"I downloaded the report.","hint":"Gi- marks the completed goal-focused action; the English root remains recognisable.","analysis":{"tokens":[["Gi-download","downloaded"],["nako","by-me"],["ang","topic marker"],["report","report"]],"literal":"Downloaded by-me [TOPIC] report."}},{"id":"ceb_cs_mag_email","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"Mag-email ko nimo","meaning":"I’ll email you","origin":"Mixed","example":"Mag-email ko nimo.","natural":"I’ll email you.","hint":"Mag- turns the English noun or verb email into a Cebuano predicate.","analysis":{"tokens":[["Mag-email","will-email"],["ko","I"],["nimo","you"]],"literal":"Will-email I you."}},{"id":"ceb_cs_i_check","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"I-check nako","meaning":"I’ll check it","origin":"Mixed","example":"I-check nako.","natural":"I’ll check it.","hint":"A compact workplace form using Cebuano i- and nako around an English root.","analysis":{"tokens":[["I-check","check-it"],["nako","by-me"]],"literal":"Check by-me."}},{"id":"ceb_cs_deadline","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"Naa koy deadline ugma","meaning":"I have a deadline tomorrow","origin":"Mixed","example":"Naa koy deadline ugma.","natural":"I have a deadline tomorrow.","hint":"The English noun deadline sits inside the Cebuano existence or possession pattern naa koy.","analysis":{"tokens":[["Naa","there-is"],["ko-y","I-LINK"],["deadline","deadline"],["ugma","tomorrow"]],"literal":"There-is I deadline tomorrow."}},{"id":"ceb_cs_busy","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"Busy pa ko","meaning":"I’m still busy","origin":"Mixed","example":"Busy pa ko.","natural":"I’m still busy.","hint":"English busy acts as the predicate while Cebuano pa and ko carry the time and person information.","analysis":{"tokens":[["Busy","busy"],["pa","still"],["ko","I"]],"literal":"Busy still I."}},{"id":"ceb_cs_free_later","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"Free ka later?","meaning":"Are you free later?","origin":"Mixed","example":"Free ka later?","natural":"Are you free later?","hint":"A common short switch: English predicate and time word with the Cebuano pronoun ka.","analysis":{"tokens":[["Free","free"],["ka","you"],["later","later"]],"literal":"Free you later?"}},{"id":"ceb_cs_online","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"Online ra ta","meaning":"We’ll just meet online / We’re online only","origin":"Mixed","example":"Online ra ta.","natural":"We’ll just do it online.","hint":"Ra narrows or softens the English predicate online; ta includes the listener.","analysis":{"tokens":[["Online","online"],["ra","just"],["ta","we-inclusive"]],"literal":"Online just we."}},{"id":"ceb_cs_office","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"Sa office ko karon","meaning":"I’m at the office now","origin":"Mixed","example":"Sa office ko karon.","natural":"I’m at the office now.","hint":"The English place noun follows the Cebuano location marker sa.","analysis":{"tokens":[["Sa","at"],["office","office"],["ko","I"],["karon","now"]],"literal":"At office I now."}},{"id":"ceb_cs_wfh","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"Mag-work from home ko ugma","meaning":"I’ll work from home tomorrow","origin":"Mixed","example":"Mag-work from home ko ugma.","natural":"I’ll work from home tomorrow.","hint":"The English workplace phrase takes Cebuano mag-, ko, and ugma.","analysis":{"tokens":[["Mag-work from home","work-from-home"],["ko","I"],["ugma","tomorrow"]],"literal":"Will-work-from-home I tomorrow."},"accepted":["Mag-WFH ko ugma"]},{"id":"ceb_cs_cancel","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"Cancel sa nato","meaning":"Let’s cancel it for now","origin":"Mixed","example":"Cancel sa nato.","natural":"Let’s cancel it for now.","hint":"Sa means for now here, and nato includes the listener in the decision.","analysis":{"tokens":[["Cancel","cancel"],["sa","for-now"],["nato","by-us-inclusive"]],"literal":"Cancel for-now by-us."}},{"id":"ceb_cs_confirm","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"Confirm lang nako","meaning":"I’ll just confirm it","origin":"Mixed","example":"Confirm lang nako.","natural":"I’ll just confirm it.","hint":"English confirm works as the predicate; lang and nako keep the Cebuano rhythm and stance.","analysis":{"tokens":[["Confirm","confirm"],["lang","just"],["nako","by-me"]],"literal":"Confirm just by-me."}},{"id":"ceb_cs_schedule","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"Okay ra ang schedule","meaning":"The schedule is fine","origin":"Mixed","example":"Okay ra ang schedule.","natural":"The schedule is fine.","hint":"English okay and schedule are held together by Cebuano ra and ang.","analysis":{"tokens":[["Okay","okay"],["ra","just / fine"],["ang","topic marker"],["schedule","schedule"]],"literal":"Okay just [TOPIC] schedule."}},{"id":"ceb_cs_final_plan","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"Mao ni ang final plan","meaning":"This is the final plan","origin":"Mixed","example":"Mao ni ang final plan.","natural":"This is the final plan.","hint":"Mao ni and ang form the Cebuano frame around the English noun phrase final plan.","analysis":{"tokens":[["Mao","this-is"],["ni","this"],["ang","topic marker"],["final","final"],["plan","plan"]],"literal":"This-is this [TOPIC] final plan."}},{"id":"ceb_cs_next_week","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"Pwede ba next week?","meaning":"Would next week work?","origin":"Mixed","example":"Pwede ba next week?","natural":"Would next week work?","hint":"Pwede is established Philippine usage; ba marks the question and next week supplies the scheduling phrase.","analysis":{"tokens":[["Pwede","possible / okay"],["ba","question"],["next week","next week"]],"literal":"Possible question next week?"}},{"id":"ceb_cs_need_help","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"Need nako og help","meaning":"I need help","origin":"Mixed","example":"Need nako og help.","natural":"I need help.","hint":"The English predicate and noun remain inside a Cebuano possessor and object-marker pattern.","analysis":{"tokens":[["Need","need"],["nako","by-me / my"],["og","object marker"],["help","help"]],"literal":"Need by-me [OBJ] help."},"accepted":["Kinahanglan ko og tabang"]},{"id":"ceb_cs_update","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"Mag-update lang ko nimo","meaning":"I’ll just update you","origin":"Mixed","example":"Mag-update lang ko nimo.","natural":"I’ll just update you.","hint":"Mag- and the Cebuano pronouns frame the English root update.","analysis":{"tokens":[["Mag-update","will-update"],["lang","just"],["ko","I"],["nimo","you"]],"literal":"Will-update just I you."},"accepted":["Update lang ko nimo"]},{"id":"ceb_cs_task_done","module":"codeSwitching","kind":"pattern","skill":"code-switching","term":"Human na ang task","meaning":"The task is finished","origin":"Mixed","example":"Human na ang task.","natural":"The task is finished.","hint":"The native Cebuano predicate human and particle na describe the English noun task.","analysis":{"tokens":[["Human","finished"],["na","already"],["ang","topic marker"],["task","task"]],"literal":"Finished already [TOPIC] task."}}],"dialogue":{"title":"Coordinating work in Bisaya-English City","level":"Beginner 6","note":"This dialogue models purposeful code-switching. English content words enter a Cebuano grammatical frame; particles and pronouns continue to carry tone, timing, and relationships.","lines":[{"speaker":"A","text":"Free ka later? Naa koy question bahin sa report.","tokens":[["Free","free"],["ka","you"],["later","later"],["Naa","there-is"],["ko-y","I-LINK"],["question","question"],["bahin sa","about"],["report","report"]],"literal":"Free you later? There-is I question about report.","natural":"Are you free later? I have a question about the report."},{"speaker":"B","text":"Busy pa ko karon, pero online ra ta alas dos.","tokens":[["Busy","busy"],["pa","still"],["ko","I"],["karon","now"],["pero","but"],["online","online"],["ra","just"],["ta","we-inclusive"],["alas dos","two o’clock"]],"literal":"Busy still I now, but online just we at-two.","natural":"I’m still busy now, but we can meet online at two."},{"speaker":"A","text":"Sige. I-send lang nako ang file before sa meeting.","tokens":[["Sige","okay"],["I-send","send-it"],["lang","just"],["nako","by-me"],["ang","topic marker"],["file","file"],["before sa","before"],["meeting","meeting"]],"literal":"Okay. Send just by-me [TOPIC] file before meeting.","natural":"Okay. I’ll send the file before the meeting."},{"speaker":"B","text":"Okay. I-check nako, then mag-update lang ko nimo.","tokens":[["Okay","okay"],["I-check","check-it"],["nako","by-me"],["then","then"],["mag-update","will-update"],["lang","just"],["ko","I"],["nimo","you"]],"literal":"Okay. Check by-me, then will-update just I you.","natural":"Okay. I’ll check it, then I’ll update you."},{"speaker":"A","text":"Salamat. Confirm lang nako ang schedule.","tokens":[["Salamat","thanks"],["Confirm","confirm"],["lang","just"],["nako","by-me"],["ang","topic marker"],["schedule","schedule"]],"literal":"Thanks. Confirm just by-me [TOPIC] schedule.","natural":"Thanks. I’ll just confirm the schedule."}]},"starterExercises":[{"id":"ceb_cs_ex_01","type":"sentence-builder","prompt":"Build: ‘We’re having a meeting now.’","answerTokens":["Mag-meeting","mi","karon."],"wordBank":["karon.","mi","Mag-meeting","ugma","ko","later"],"itemIds":["ceb_cs_mag_meeting"]},{"id":"ceb_cs_ex_02","type":"sentence-builder","prompt":"Build: ‘I’ll just send the file.’","answerTokens":["I-send","lang","nako","ang","file."],"wordBank":["file.","ang","I-send","nako","lang","report"],"itemIds":["ceb_cs_i_send"]},{"id":"ceb_cs_ex_03","type":"choice","prompt":"What does ‘Gi-download nako ang report’ mean?","answer":"I downloaded the report","choices":["I downloaded the report","I’ll email the report","The report is late","Please check the report"],"itemIds":["ceb_cs_gi_download"]},{"id":"ceb_cs_ex_04","type":"sentence-builder","prompt":"Build: ‘I have a deadline tomorrow.’","answerTokens":["Naa","koy","deadline","ugma."],"wordBank":["ugma.","deadline","Naa","koy","meeting","sa"],"itemIds":["ceb_cs_deadline"]},{"id":"ceb_cs_ex_05","type":"sentence-builder","prompt":"Build: ‘I’m still busy.’","answerTokens":["Busy","pa","ko."],"wordBank":["ko.","pa","Busy","Free","later","ra"],"itemIds":["ceb_cs_busy"]},{"id":"ceb_cs_ex_06","type":"choice","prompt":"Which phrase asks ‘Are you free later?’","answer":"Free ka later?","choices":["Free ka later?","Busy pa ko","Online ra ta","Cancel sa nato"],"itemIds":["ceb_cs_free_later"]},{"id":"ceb_cs_ex_07","type":"sentence-builder","prompt":"Build: ‘We’ll just do it online.’","answerTokens":["Online","ra","ta."],"wordBank":["ta.","ra","Online","office","ko","karon"],"itemIds":["ceb_cs_online"]},{"id":"ceb_cs_ex_08","type":"sentence-builder","prompt":"Build: ‘I’m at the office now.’","answerTokens":["Sa","office","ko","karon."],"wordBank":["karon.","office","Sa","ko","online","ugma"],"itemIds":["ceb_cs_office"]},{"id":"ceb_cs_ex_09","type":"choice","prompt":"What does ‘Cancel sa nato’ mean?","answer":"Let’s cancel it for now","choices":["Let’s cancel it for now","Please confirm it","The task is done","We’ll meet online"],"itemIds":["ceb_cs_cancel"]},{"id":"ceb_cs_ex_10","type":"sentence-builder","prompt":"Build: ‘The schedule is fine.’","answerTokens":["Okay","ra","ang","schedule."],"wordBank":["schedule.","ang","Okay","ra","final","task"],"itemIds":["ceb_cs_schedule"]},{"id":"ceb_cs_ex_11","type":"sentence-builder","prompt":"Build: ‘I’ll just update you.’","answerTokens":["Mag-update","lang","ko","nimo."],"wordBank":["nimo.","ko","Mag-update","lang","later","file"],"itemIds":["ceb_cs_update"]},{"id":"ceb_cs_ex_12","type":"sentence-builder","prompt":"Build: ‘The task is finished.’","answerTokens":["Human","na","ang","task."],"wordBank":["task.","ang","Human","na","schedule","pa"],"itemIds":["ceb_cs_task_done"]}]}